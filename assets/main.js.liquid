        totalItemsWithIngraving = 0;
  
  	_.each(CART.items, function(item){
        if(item.product_type.toLowerCase() !== 'logo' && item.properties){      
          	
          	_.each(item.properties, function(v,c){
              	if(c.indexOf('color') > -1){
              		totalItemsWithIngraving += item.quantity;
              	}
            });
          
        }
    });
  

    return {
        cartHastFirstIngraving : cartHastFirstIngraving,
        cartHasSecondIngraving : cartHasSecondIngraving,
        cartHasStdPlate : cartHasStdPlate,
        cartHasBagPlate : cartHasBagPlate,
        cartHasLargeBagPlate : cartHasLargeBagPlate,
      	logoNeedsPlate : logoNeedsPlate,
      	cartHasBagsWithPrinting : cartHasBagsWithPrinting,
        cartHasLargeBagsWithPrinting : cartHasLargeBagsWithPrinting,
      	cartHasItemsWithPrinting : cartHasItemsWithPrinting,
        count : totalItemsWithIngraving
    };

}

function verifyAdjustedPrintingItems(done, fail, attempt, operation){
    var verificationStartedAt = Date.now();

    printingCartLog(operation, 'Reloading cart for verification', {
        attempt: attempt
    });

    $.ajax({
        url: '/cart.js',
        method: 'GET',
        dataType: 'json',
        cache: false
    }).done(function(cart){
        CART = cart;
        $('#CartCount').text(CART.items.length);
        $(document).trigger('CART');

        var verification = verifyPrintingCartItems();

        if(verification.valid){
            printingCartLog(operation, 'Verification passed', {
                attempt: attempt,
                printingCount: verification.printingCount,
                expectedFees: verification.expected,
                actualFees: verification.actual,
                verificationMs: Date.now() - verificationStartedAt,
                totalMs: Date.now() - operation.startedAt
            });
            printingCartClarityEvent(operation, 'printing_cart_verification_passed', {
                printing_cart_result: 'passed',
                printing_cart_attempt: attempt,
                printing_count: verification.printingCount,
                printing_total_ms: Date.now() - operation.startedAt
            });
            if(done){
                done();
            }
        }else if(attempt < 2){
            printingCartLog(operation, 'Verification found incorrect fees; retrying reconciliation', {
                attempt: attempt,
                mismatches: verification.mismatches,
                expectedFees: verification.expected,
                actualFees: verification.actual,
                verificationMs: Date.now() - verificationStartedAt
            }, 'warn');
            printingCartClarityEvent(operation, 'printing_cart_verification_retry', {
                printing_cart_result: 'retrying',
                printing_cart_attempt: attempt,
                printing_mismatch: verification.mismatches.map(function(item){ return item.fee; })
            });
            adjustLogoItems(done, fail, attempt + 1, operation);
        }else if(fail){
            printingCartLog(operation, 'Verification failed after retry', {
                attempt: attempt,
                mismatches: verification.mismatches,
                expectedFees: verification.expected,
                actualFees: verification.actual,
                totalMs: Date.now() - operation.startedAt
            }, 'error');
            printingCartClarityEvent(operation, 'printing_cart_verification_failed', {
                printing_cart_result: 'failed',
                printing_cart_attempt: attempt,
                printing_mismatch: verification.mismatches.map(function(item){ return item.fee; }),
                printing_total_ms: Date.now() - operation.startedAt
            });
            getClarityClient()('upgrade', 'printing-cart-verification-failed');
            fail(verification);
        }else{
            printingCartLog(operation, 'Verification failed after retry; continuing legacy callback', {
                attempt: attempt,
                mismatches: verification.mismatches,
                expectedFees: verification.expected,
                actualFees: verification.actual,
                totalMs: Date.now() - operation.startedAt
            }, 'error');
            printingCartClarityEvent(operation, 'printing_cart_verification_failed', {
                printing_cart_result: 'failed',
                printing_cart_attempt: attempt,
                printing_mismatch: verification.mismatches.map(function(item){ return item.fee; }),
                printing_total_ms: Date.now() - operation.startedAt
            });
            getClarityClient()('upgrade', 'printing-cart-verification-failed');
            if(done){
                done();
            }
        }
    }).fail(function(xhr){
        if(attempt < 2){
            printingCartLog(operation, 'Cart reload failed; retrying reconciliation', {
                attempt: attempt,
                status: xhr.status,
                verificationMs: Date.now() - verificationStartedAt
            }, 'warn');
            printingCartClarityEvent(operation, 'printing_cart_reload_retry', {
                printing_cart_result: 'reload_retrying',
                printing_cart_attempt: attempt,
                printing_http_status: String(xhr.status || 0)
            });
            adjustLogoItems(done, fail, attempt + 1, operation);
        }else if(fail){
            printingCartLog(operation, 'Cart reload failed after retry', {
                attempt: attempt,
                status: xhr.status,
                totalMs: Date.now() - operation.startedAt
            }, 'error');
            printingCartClarityEvent(operation, 'printing_cart_reload_failed', {
                printing_cart_result: 'reload_failed',
                printing_cart_attempt: attempt,
                printing_http_status: String(xhr.status || 0),
                printing_total_ms: Date.now() - operation.startedAt
            });
            getClarityClient()('upgrade', 'printing-cart-reload-failed');
            fail({
                valid: false,
                reason: 'Unable to reload the cart after adding printing fees.',
                status: xhr.status
            });
        }else{
            printingCartLog(operation, 'Cart reload failed after retry; continuing legacy callback', {
                attempt: attempt,
                status: xhr.status,
                totalMs: Date.now() - operation.startedAt
            }, 'error');
            printingCartClarityEvent(operation, 'printing_cart_reload_failed', {
                printing_cart_result: 'reload_failed',
                printing_cart_attempt: attempt,
                printing_http_status: String(xhr.status || 0),
                printing_total_ms: Date.now() - operation.startedAt
            });
            getClarityClient()('upgrade', 'printing-cart-reload-failed');
            if(done){
                done();
            }
        }
    });
}

function verifyPrintingCartItems(){
    var logoInfo = getTotalItemsWithIngravig(),
        quantities = {},
        expected = {},
        expectedByName = {},
        actualByName = {},
        feeNames = {},
        mismatches = [];

    feeNames[LOGO_ID] = 'Printing fee - first 200';
    feeNames[LOGO_ID_200] = 'Printing fee - additional prints';
    feeNames[PLATE_STD] = 'Plate fee - boxes and pouches';
    feeNames[PLATE_BAG] = 'Plate fee - bags';
    feeNames[PLATE_BAG_LRG] = 'Plate fee - large bags';

    _.each(CART.items, function(item){
        quantities[item.id] = (quantities[item.id] || 0) + item.quantity;
    });

    expected[LOGO_ID] = logoInfo.count > 0 ? 1 : 0;
    expected[LOGO_ID_200] = logoInfo.count > 200 ? logoInfo.count - 200 : 0;
    expected[PLATE_STD] = logoInfo.logoNeedsPlate && logoInfo.cartHasItemsWithPrinting ? 1 : 0;
    expected[PLATE_BAG] = logoInfo.logoNeedsPlate && logoInfo.cartHasBagsWithPrinting ? 1 : 0;
    expected[PLATE_BAG_LRG] = logoInfo.logoNeedsPlate && logoInfo.cartHasLargeBagsWithPrinting ? 1 : 0;

    _.each(expected, function(expectedQuantity, id){
        var actualQuantity = quantities[id] || 0,
            feeName = feeNames[id];

        expectedByName[feeName] = expectedQuantity;
        actualByName[feeName] = actualQuantity;

        if(actualQuantity !== expectedQuantity){
            mismatches.push({
                fee: feeName,
                id: Number(id),
                expected: expectedQuantity,
                actual: actualQuantity
            });
        }
    });

    return {
        valid: mismatches.length === 0,
        printingCount: logoInfo.count,
        expected: expectedByName,
        actual: actualByName,
        mismatches: mismatches
    };
}

