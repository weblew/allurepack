function printingCartLog(operation, message, details, level){
    var logger = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log,
        prefix = '[Printing Cart #' + operation.id + ']';

    if(typeof details === 'undefined'){
        logger.call(console, prefix, message);
    }else{
        logger.call(console, prefix, message, details);
    }
}

function printingCartRequestResult(operation, action, response, textStatus){
    var status = response && typeof response.status === 'number' ? response.status : 200,
        failed = status >= 400 || textStatus === 'error' || textStatus === 'timeout';

    printingCartLog(operation, action + (failed ? ' failed' : ' completed'), {
        status: status,
        result: textStatus || (failed ? 'error' : 'success')
    }, failed ? 'error' : 'log');

    if(failed){
        printingCartClarityEvent(operation, 'printing_fee_request_failed', {
            printing_cart_result: 'request_failed',
            printing_failed_action: action,
            printing_http_status: String(status)
        });
    }
}

function getOrCreatePrintingTraceId(){
    var storageKey = 'allure_printing_trace_id',
        traceId;

    try{
        traceId = window.sessionStorage.getItem(storageKey);
    }catch(e){}

    if(!traceId){
        traceId = 'PT-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();

        try{
            window.sessionStorage.setItem(storageKey, traceId);
        }catch(e){}
    }

    return traceId;
}

function ensurePrintingTraceInput($form){
    var traceInput = $form.find('[name="properties[_Printing Trace ID]"]'),
        hasPrinting = $form.find('[name^="properties[Printing "][name$=" color]"]').length > 0,
        traceId;

    if(!hasPrinting){
        traceInput.remove();
        return '';
    }

    traceId = getOrCreatePrintingTraceId();

    if(traceInput.length){
        traceInput.val(traceId);
    }else{
        $('<input>', {
            type: 'hidden',
            name: 'properties[_Printing Trace ID]',
            value: traceId,
            class: 'js-printing-trace-id'
        }).appendTo($form);
    }

    registerPrintingTraceWithClarity(traceId);

    return traceId;
}

function registerPrintingTraceWithClarity(traceId){
    var clarity;

    if(!traceId){
        return;
    }

    clarity = getClarityClient();
    clarity('identify', traceId, traceId);
    clarity('set', 'printing_trace_id', traceId);

    console.log('[Printing Trace]', 'Clarity lookup identifiers assigned', {
        traceId: traceId,
        customUserId: traceId,
        customSessionId: traceId
    });
}

function getPrintingTraceIds(){
    var traceIds = [];

    _.each(CART.items || [], function(item){
        var traceId = item.properties && item.properties['_Printing Trace ID'];

        if(traceId && traceIds.indexOf(traceId) === -1){
            traceIds.push(String(traceId));
        }
    });

    return traceIds;
}

function getClarityClient(){
    if(typeof window.clarity !== 'function'){
        window.clarity = function(){
            (window.clarity.q = window.clarity.q || []).push(arguments);
        };
    }

    return window.clarity;
}

function printingCartClarityEvent(operation, eventName, tags){
    var clarity = getClarityClient(),
        traceIds = operation.traceIds || [];

    if(traceIds.length){
        clarity('set', 'printing_trace_id', traceIds.length === 1 ? traceIds[0] : traceIds);
    }

    _.each(tags || {}, function(value, key){
        if(value !== null && typeof value !== 'undefined'){
            clarity('set', key, Array.isArray(value) ? value : String(value).slice(0, 255));
        }
    });

    clarity('event', eventName);
}

