                $.get('/cart/add.js?quantity=1&id=' + getRushVariant().id).always(function(res, addTextStatus){
                    printingCartRequestResult(operation, 'Replacement rush-printing fee add', res, addTextStatus);
                    if(done){
                        done();
                    }
                });

            });
        }else{
        
			printingCartLog(operation, 'Rush-printing fee does not need adjustment', {
				attempt: attempt,
				currentVariantId: window.RUSH_PRINTING_ID || null,
				expectedVariantId: getRushVariant() ? getRushVariant().id : null
			});

